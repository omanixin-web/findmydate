# Copy to .env.local and change every value before deploying.
# The secret URL where the admin login page lives. Must start with "/". Use a long random string.
ADMIN_LOGIN_PATH=/sanchit
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Supabase Database Configuration (Required for Vercel / Production)
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fallback for local development if Supabase keys are not set:
DATA_DIR=./data
