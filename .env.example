# Copy to .env.local and change every value before deploying.
# The secret URL where the admin login page lives. Must start with "/". Use a long random string.
ADMIN_LOGIN_PATH=/sanchit
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Where db.json is stored (use a persistent disk in production).
DATA_DIR=./data
